<?xml version="1.0" encoding="UTF-8"?>
<Workspace>
	<Test id="*">
		<Type range="{Acq2pMode, Default, PeakingTime, StdAcquisition}">StdAcquisition</Type>
		<Setup id="*" />
		<Setup id="Hardware">
			<Path type="string"></Path>
		</Setup>
		<Setup id="Conditions">
			<Path type="string"></Path>
		</Setup>
		<Setup id="Data">
			<Path>/tmp</Path>
		</Setup>
		<Setup id="Network">
			<IpNode id="*">
				<addressField id="0" range="[0, 255]">192</addressField>
				<addressField id="1">168</addressField>
				<addressField id="2">0</addressField>
				<addressField id="3">0</addressField>
				<port range="[0, 65535]">46001</port>
				<addressField id="*">255</addressField>
			</IpNode>
			<IpNode id="ECC">
				<port>46002</port>
			</IpNode>
			<IpNode id="DAQ">
				<port>46003</port>
			</IpNode>
			<IpNode id="TARGET" />
		</Setup>
	</Test>
	<Test id="test">
		<Type>Default</Type>
		<Setup id="Hardware">
			<Path>/home/axis/getdaq/config/test/hardwareDescription_fullCoBoStandAlone.xcfg</Path>
		</Setup>
		<Setup id="Conditions">
			<Path>/home/axis/getdaq/config/configure-ExternalTrigger-2CoBo_1Mutant.xcfg</Path>
		</Setup>
		<Setup id="Data">
			<Path>/home/axis/getdaq/data</Path>
		</Setup>
		<Setup id="Network">
			<IpNode id="ECC">
				<addressField id="2">1</addressField>
				<addressField id="3">1</addressField>
			</IpNode>
			<IpNode id="TARGET">
				<addressField id="2">1</addressField>
				<addressField id="3">100</addressField>
			</IpNode>
		</Setup>
	</Test>
</Workspace>
